# SwimCoach env — single source. Copy to `.env` for local dev.
# Prod (Render dashboard → Environment) uses the SAME keys with prod values;
# see docs/ops.md for the Render/Supabase runbook. No secrets here, ever.
#
# REQUIRED in every environment (app refuses to boot without them):
#   SECRET_KEY, MP_ACCESS_TOKEN, MP_PUBLIC_KEY
# Everything else has a safe dev default below.

# --- App ---
APP_NAME=SwimCoach
ENVIRONMENT=development          # development | production
FRONTEND_URL=http://localhost:8000  # local: same-origin (StaticFiles). Prod: https://swimcoach-ss5j.onrender.com
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days (cookie max-age mirrors this)

# --- Database ---
# Local dev: sqlite file (created automatically; uses create_all, NOT alembic).
DATABASE_URL=sqlite:///./swim_coach.db
# Prod (Supabase pooler, IPv4 — Render Free has no IPv6):
# DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Prod migrations: alembic upgrade head (local sqlite stamp is stale by design — never run it locally).

# --- MercadoPago (https://www.mercadopago.com.mx/developers/panel) ---
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx            # prod: APP_USR-xxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxx              # prod: APP_USR-xxx
MP_WEBHOOK_SECRET=                               # empty = auto-plan (no signature check); whsec_xxx in prod when selling
MP_PREAPPROVAL_PLAN_ID=pro_monthly               # prod: plan id from MP dashboard ($100 MXN/mo)

# --- Google AdSense (https://www.google.com/adsense) ---
# NOTE: backend ADSENSE_* envs are currently UNWIRED (see backend/services/attic_ads_service.py).
# Live slot IDs are hardcoded in frontend (dashboard/session/feedback/public.js):
# client ca-pub-4540036176937342, banner 7276396302, in-content 2885278049.
ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
ADSENSE_SLOT_BANNER=1234567890
ADSENSE_SLOT_INTERSTITIAL=0987654321

# --- Analytics (optional) ---
UMAMI_WEBSITE_ID=
SENTRY_DSN=

# --- Web Push / VAPID (Phase 1: storage + manual test sends) ---
# Generate once: .\venv\Scripts\python.exe tools/gen_vapid.py
# Empty = push endpoints return vapid-key "" and subscribe toggle shows "not configured".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:swimcoach.app@gmail.com
