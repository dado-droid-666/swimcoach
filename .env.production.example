# SwimCoach Production Environment Variables
# Copy to .env and fill in all values

# App Configuration
APP_NAME=SwimCoach
ENVIRONMENT=production
FRONTEND_URL=https://your-domain.com

# Security - Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Database - Use PostgreSQL in production
# Railway/Render will provide this automatically
DATABASE_URL=postgresql://user:password@host:5432/dbname

# MercadoPago (Production credentials from MercadoPago dashboard)
# Get from: https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
MP_PREAPPROVAL_PLAN_ID=plan_id_from_mercadopago_dashboard

# Google AdSense (Get from: https://www.google.com/adsense)
# Create ad units for banner and interstitial
ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
ADSENSE_SLOT_BANNER=1234567890
ADSENSE_SLOT_INTERSTITIAL=0987654321

# Analytics (Optional)
# Umami: https://umami.is/ or Plausible: https://plausible.io
UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Error Tracking (Optional)
# Sentry: https://sentry.io/
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXXX.ingest.sentry.io/XXXXXXX

# Redis (Optional - for caching/background jobs in future)
# REDIS_URL=redis://user:password@host:6379/0

# Email (Optional - for notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=SwimCoach <noreply@yourdomain.com>